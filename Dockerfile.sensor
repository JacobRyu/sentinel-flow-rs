# Build stage
FROM rust:1.90-slim as builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy manifests
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Build
RUN cargo build --release --bin sentinel-sensor

# Runtime stage
# Matches the builder base (trixie) so the glibc in the runtime image is never
# older than the one the binary was linked against.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/sentinel-sensor /usr/local/bin/

ENTRYPOINT ["sentinel-sensor"]
